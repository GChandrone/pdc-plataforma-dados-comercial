{
  "datasets": [
    {
      "name": "ds_fato",
      "displayName": "Pedidos de venda",
      "queryLines": [
        "SELECT f.dat_emissao, f.des_status, f.vlr_total, f.vlr_saldo, f.qtd_vendida, u.des_unidade,\n",
        "       p.des_produto, v.des_nome AS des_vendedor, c.des_nome AS des_cliente\n",
        "FROM comercial.fato_pedido_venda f\n",
        "JOIN comercial.dim_unidade u ON f.cod_empresa = u.cod_empresa AND f.cod_filial = u.cod_filial\n",
        "LEFT JOIN comercial.dim_produto p ON f.cod_empresa = p.cod_empresa AND f.cod_produto = p.cod_produto\n",
        "LEFT JOIN comercial.dim_vendedor v ON f.cod_empresa = v.cod_empresa AND f.cod_vendedor = v.cod_vendedor\n",
        "LEFT JOIN comercial.dim_cliente c ON f.cod_empresa = c.cod_empresa AND f.cod_cliente = c.cod_cliente\n",
        "     AND f.cod_loja = c.cod_loja\n"
      ]
    },
    {
      "name": "ds_atualizacao",
      "displayName": "Última atualização",
      "queryLines": [
        "SELECT date_format(MAX(dat_atualizacao), 'dd/MM/yyyy HH:mm') AS des_ultima_carga\n",
        "FROM comercial.fato_pedido_venda\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "pagina_comercial",
      "displayName": "Visão Comercial",
      "layout": [
        {
          "widget": {
            "name": "w_valor_vendido",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_fato",
                  "fields": [
                    {
                      "name": "sum(vlr_total)",
                      "expression": "SUM(`vlr_total`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(vlr_total)",
                  "displayName": "Valor vendido (R$)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Valor vendido (R$)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 2,
            "height": 3
          }
        },
        {
