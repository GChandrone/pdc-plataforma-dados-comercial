# Copie este arquivo para .env e preencha os valores. O .env NUNCA deve ser versionado.

# PostgreSQL do ERP simulado
PG_USER=erp
PG_PASSWORD=<defina-uma-senha-forte>
PG_DB=erp_protheus

# Banco de metadados do Airflow
AIRFLOW_DB_PASSWORD=<defina-uma-senha-forte>

# Databricks (workspace Free Edition e token pessoal de acesso)
DATABRICKS_HOST=https://<seu-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<seu-token-pessoal>

# Extrator
LANDING_PATH=/Volumes/landing/protheus/arquivos
OVERLAP_MINUTES=10
